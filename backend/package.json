{
  "name": "roast-and-bean-backend",
  "version": "1.0.0",
  "description": "Backend API for Roast & Bean coffee store",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
